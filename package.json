{
  "name": "komari-theme-minimal",
  "private": true,
  "type": "module",
  "description": "A minimal, monochrome theme for Komari Monitor.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "verify": "node scripts/verify.mjs",
    "mock": "node scripts/mock-server.mjs",
    "smoke": "node scripts/smoke.mjs",
    "render": "node scripts/render-check.mjs",
    "render:no-rpc2": "node scripts/render-check.mjs --no-rpc2",
    "render:no-metrics": "node scripts/render-check.mjs --no-metrics",
    "browser": "npm run build && node scripts/browser-check.mjs",
    "dev:check": "node scripts/dev-check.mjs",
    "format:check": "node scripts/format-check.mjs",
    "test": "npm run format:check && npm run smoke && npm run render && npm run render:no-rpc2 && npm run render:no-metrics && npm run dev:check",
    "icons": "node scripts/fetch-os-icons.mjs",
    "flags": "node scripts/fetch-flags.mjs",
    "package": "npm run build && npm run verify && node scripts/package.mjs && node scripts/zip-check.mjs"
  },
  "dependencies": {
    "i18next": "23.16.8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "15.1.3",
    "react-router-dom": "6.28.0",
    "uplot": "1.6.31"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "22.10.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.2",
    "vite": "6.0.7"
  }
}
